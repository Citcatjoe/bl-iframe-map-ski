# Copier vers .env (jamais commité). Toutes les variables sont optionnelles.

# Moteur de carte : "maplibre" (défaut, sans token) ou "mapbox".
# Choix non tranché : voir ETAT-DU-PROJET.md § 4.3.
VITE_MAP_ENGINE=maplibre

# URL du style, par thème. Défaut : OpenFreeMap Positron (clair) et Dark (sombre, #theme=dark).
# En mode mapbox, mettre les URL des styles Studio Blick (mapbox://styles/...).
VITE_MAP_STYLE_LIGHT=
VITE_MAP_STYLE_DARK=

# Token Mapbox (mode mapbox uniquement). Un token pk.* finit dans le bundle livré
# au navigateur : sa vraie protection est la restriction de domaine côté compte Mapbox.
VITE_MAPBOX_TOKEN=pk.votre_token_mapbox

# URL du fichier météo. Défaut : data/weather.json (produit en local par `npm run weather`).
# Build : .env.production (VPS) ; `npm run dev:vps` : .env.vps (VPS).
VITE_WEATHER_URL=
